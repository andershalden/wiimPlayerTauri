{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiiM Player",
  "version": "0.1.0",
  "identifier": "no.halden.wiimplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WiiM Player",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#0f1115",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https: asset:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Music",
    "shortDescription": "WiiM remote and music player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
